{
  "permissions": {
    "deny": [
      "Read(./.env)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "Bash(git push *)"
    ],
    "defaultMode": "default"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/straznik-sekretow.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bramka-testow.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
